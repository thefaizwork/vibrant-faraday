# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROK_API_KEY=your_xai_grok_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# System Mode: generator_only | general_critic | specialized_multi_agent
SYSTEM_MODE=specialized_multi_agent

# Global Provider Default (mock | grok | groq | openai | anthropic)
DEFAULT_PROVIDER=grok
DEFAULT_MODEL=grok-2-latest

# Per-Agent Provider / Model Overrides
PROMPT_STRUCTURER_PROVIDER=grok
PROMPT_STRUCTURER_MODEL=grok-2-latest

GENERATOR_PROVIDER=grok
GENERATOR_MODEL=grok-2-latest

AESTHETIC_AGENT_PROVIDER=grok
AESTHETIC_AGENT_MODEL=grok-2-latest

ACCESSIBILITY_AGENT_PROVIDER=grok
ACCESSIBILITY_AGENT_MODEL=grok-2-latest

USABILITY_AGENT_PROVIDER=grok
USABILITY_AGENT_MODEL=grok-2-latest

ETHICS_AGENT_PROVIDER=grok
ETHICS_AGENT_MODEL=grok-2-latest

ORIGINALITY_AGENT_PROVIDER=grok
ORIGINALITY_AGENT_MODEL=grok-2-latest

GENERAL_CRITIC_PROVIDER=grok
GENERAL_CRITIC_MODEL=grok-2-latest

AGGREGATOR_PROVIDER=grok
AGGREGATOR_MODEL=grok-2-latest

REFINER_PROVIDER=grok
REFINER_MODEL=grok-2-latest

# System Limits
MAX_ITERATIONS=3
QUALITY_THRESHOLD=8.0
COST_LIMIT=2.00
TIME_LIMIT=120
